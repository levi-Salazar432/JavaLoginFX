    <stylesheets>
        <URL value="@/org/levisalazar/View/style/cajerodashboardview.css" />
    </stylesheets>
   <children>
      <Label fx:id="lblBienvenida" layoutX="330.0" layoutY="70.0" prefHeight="30.0" prefWidth="200.0" styleClass="welcome-label" text="¡Bienvenido, Cajero!" />
      <Button fx:id="btnSalir" layoutX="50.0" layoutY="68.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="110.0" styleClass="btn-salir" text="Salir" />
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="175.0" layoutY="200.0" prefHeight="59.0" prefWidth="250.0" styleClass="cajero-title" text="MÓDULO CAJERO">
         <font>
            <Font size="25.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
