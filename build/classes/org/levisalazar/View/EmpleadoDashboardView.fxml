      <Button fx:id="btnSalir" layoutX="50.0" layoutY="68.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="110.0" styleClass="btn-salir" text="Salir" />
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="175.0" layoutY="200.0" prefHeight="59.0" prefWidth="250.0" styleClass="empleado-title" text="MÓDULO EMPLEADO">
